# MySQL config
MYSQL_ROOT_PASSWORD=

# Per-service DB passwords
ATTENDANCE_DB_PASSWORD=
AUTH_DB_PASSWORD=
EMPLOYEE_DB_PASSWORD=

# DB connection urls (replace [password] with the above password)
ATTENDANCE_DB_URL=mysql://attendance_svc:[password]@mysql:3306/attendance_db
AUTH_DB_URL=mysql://auth_svc:[password]@mysql:3306/auth_db
EMPLOYEE_DB_URL=mysql://employee_svc:[password]@mysql:3306/employee_db

# JWT
JWT_SECRET=secret
JWT_EXPIRY_TIME=1h

AUTH_SERVICE_URL=http://auth-service:3000