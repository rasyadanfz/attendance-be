{
  "name": "attendance-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware src/ test/",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:auth": "nest start auth-service --watch",
    "start:employee": "nest start employee-service --watch",
    "start:attendance": "nest start attendance-service --watch",
    "migration:generate:auth": "typeorm-ts-node-esm migration:generate -d apps/auth-service/src/data-source.ts",
    "migration:run:auth": "typeorm-ts-node-esm migration:run -d apps/auth-service/src/data-source.ts",
    "migration:revert:auth": "typeorm-ts-node-esm migration:revert -d apps/auth-service/src/data-source.ts",
    "migration:generate:employee": "typeorm-ts-node-esm migration:generate -d apps/employee-service/src/data-source.ts",
    "migration:run:employee": "typeorm-ts-node-esm migration:run -d apps/employee-service/src/data-source.ts",
    "migration:revert:employee": "typeorm-ts-node-esm migration:revert -d apps/employee-service/src/data-source.ts",
    "migration:generate:attendance": "typeorm-ts-node-esm migration:generate -d apps/attendance-service/src/data-source.ts",
    "migration:run:attendance": "typeorm-ts-node-esm migration:run -d apps/attendance-service/src/data-source.ts",
    "migration:revert:attendance": "typeorm-ts-node-esm migration:revert -d apps/attendance-service/src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/http-client": "^0.0.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
